<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="850.0" spacing="14.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Katalog Produk Toko" />
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="cariField" promptText="Cari nama produk..." HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="filterBox" prefWidth="140.0" />
            <Button onAction="#cari" text="Cari" />
            <Button onAction="#reset" text="Reset" />
            <Button onAction="#tambah" styleClass="button-primary" text="+ Tambah Produk" />
         </children>
      </HBox>
      
      <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
         <content>
            <TilePane fx:id="tileKatalog" hgap="16.0" prefColumns="3" vgap="16.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </TilePane>
         </content>
      </ScrollPane>
   </children>
</VBox>