<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" maxWidth="550.0" prefWidth="550.0" spacing="14.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>

      <Label styleClass="title" text="Detail Produk" />
      <Label styleClass="muted" text="Informasi lengkap mengenai produk yang dipilih" />
      
      <HBox alignment="CENTER" prefHeight="250.0">
         <children>
            <ImageView fx:id="imgProduk" fitHeight="240.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
         </children>
         <VBox.margin>
            <Insets bottom="6.0" top="10.0" />
         </VBox.margin>
      </HBox>
      
      <GridPane hgap="16.0" vgap="10.0">
         <children>
            <Label styleClass="muted" text="Kode Produk:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="lblKode" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label styleClass="muted" text="Nama Produk:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="lblNama" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label styleClass="muted" text="Kategori:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="lblKategori" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label styleClass="muted" text="Harga:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="lblHarga" style="-fx-font-weight: bold; -fx-text-fill: #ea580c; -fx-font-size: 15px;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" top="6.0" />
         </VBox.margin>
      </GridPane>
      
      
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button onAction="#handleKembali" text="Kembali" />
         </children>
      </HBox>
   </children>
</VBox>