<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" maxWidth="500.0" spacing="12.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Tambah Produk Baru" />
      <Label styleClass="muted" text="Masukkan data produk toko secara lengkap" />
      
      <Label text="Kode Produk" />
      <TextField fx:id="txtKode" promptText="Contoh: P001" />
      
      <Label text="Nama Produk" />
      <TextField fx:id="txtNama" promptText="Masukkan nama produk" />
      
      <Label text="Kategori" />
      <ComboBox fx:id="cbKategori" maxWidth="Infinity" promptText="Pilih Kategori" />
      
      <Label text="Harga (Rp)" />
      <TextField fx:id="txtHarga" promptText="Harga lebih dari 0" />
      
      <Label text="Gambar Produk" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button onAction="#handlePilihGambar" text="Pilih Gambar..." />
            <Label fx:id="lblNamaGambar" styleClass="muted" text="Belum ada file dipilih" />
         </children>
      </HBox>
      <ImageView fx:id="imgPreview" fitHeight="120.0" fitWidth="120.0" preserveRatio="true" />
      
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#handleBatal" text="Batal" />
            <Button onAction="#handleSimpan" styleClass="button-primary" text="Simpan" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>